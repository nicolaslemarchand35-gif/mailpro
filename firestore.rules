rules_version = '2';
// Tout accès client est refusé : seul le serveur (SDK Admin, identité de service)
// lit et écrit les données. Ne pas assouplir sans revoir la sécurité.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
